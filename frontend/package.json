{
  "name": "erm-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "contract:sync": "node scripts/sync-api-contract.mjs",
    "contract:check": "node scripts/sync-api-contract.mjs --check",
    "test": "node --experimental-strip-types --test tests/contract.test.ts tests/fixtures.test.ts tests/mockMonitorApi.test.ts tests/httpMonitorApi.test.ts",
    "typecheck:tests": "tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "lucide-react": "^1.59.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "npm": ">=10"
  }
}
